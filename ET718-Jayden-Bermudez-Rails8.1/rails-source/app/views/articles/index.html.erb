<section class="hero"><div class="hero-copy"><span class="eyebrow">THE SIDELINE / ISSUE 01</span><h1>Beyond the<br><em>headline.</em></h1><p>Sports, culture, technology, and the ideas that make people talk.</p><%= link_to "Write the next story →", new_article_path, class: "button button-primary" %></div><div class="hero-score" aria-hidden="true"><span>THE DAILY LINEUP</span><strong>01<span> / </span>24</strong><small>STORIES IN MOTION</small></div></section>
<% if @spotlights.any? %><section class="spotlight-section"><div class="list-heading"><div><span class="eyebrow">EDITOR'S PICK</span><h2>In the spotlight</h2></div></div><div class="spotlight-grid"><% @spotlights.each do |article| %><article class="spotlight-card"><span class="post-category"><%= article.section %> · FEATURED</span><h3><%= link_to article.title, article_path(article) %></h3><p><%= truncate(article.body, length: 140) %></p><%= link_to "Read feature →", article_path(article), class: "read-link" %></article><% end %></div></section><% end %>
<section class="list-heading"><div><span class="eyebrow">LATEST COVERAGE</span><h2>All stories</h2></div><span class="counter"><%= pluralize(@articles.size, "story") %></span></section>
<div class="filter-pills"><%= link_to "Everything", articles_path, class: (@selected_section.blank? ? "pill active" : "pill") %><% Article::SECTIONS.each do |section| %><%= link_to section, articles_path(section: section), class: (@selected_section == section ? "pill active" : "pill") %><% end %></div>
<div class="content-columns"><div class="article-grid"><%= render partial: "card", collection: @articles, as: :article %></div><aside class="sidebar"><div class="sidebar-title">MOST DISCUSSED</div><% @most_discussed.each_with_index do |article, index| %><div class="sidebar-item"><span><%= format("%02d", index + 1) %></span><div><%= link_to article.title, article_path(article) %><small><%= pluralize(article.comments.count, "comment") %></small></div></div><% end %></aside></div>
<% if @articles.empty? %><div class="empty-state">No stories in this section yet. Add the first one.</div><% end %>
